# --- IB Gateway (docker/app.Dockerfile + gnzsnz/ib-gateway) ---
IB_USER=your_ibkr_username
IB_PASSWORD=your_ibkr_password
IB_MODE=paper              # paper | live
IB_PORT=4002                # for scripts run on the Mac: host 4002=paper, 4001=live (compose overrides it for the app container)
IB_CLIENT_ID=1

# --- Database ---
PG_PASSWORD=changeme
DATABASE_URL=postgresql://postgres:changeme@db:5432/tradebot

# --- Data store ---
DATA_DIR=/data

# --- Notifications ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- Risk ---
MAX_NOTIONAL=500              # per-order cap, in BASE_CURRENCY (paper test on 250k: 75000)
BASE_CURRENCY=CAD           # must match the IBKR account's base currency
KILL_SWITCH=false

# --- Overnight strategy ---
OVERNIGHT_MIN_WEIGHT=0.5     # trade the whole SPY slice only if the sized weight is >= this
OVERNIGHT_DECISION_JITTER_MINUTES=0   # optional random delay after 15:00 ET (max 45)
OVERNIGHT_PRICE_BUFFER=0.01  # sizing buffer for the unknown closing-auction price

# --- Runner ---
POLL_INTERVAL_SECONDS=300
